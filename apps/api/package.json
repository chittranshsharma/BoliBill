{
  "name": "@bolibill/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:local": "tsx src/local-db.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.44.6",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
